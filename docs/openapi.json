{
    "openapi": "3.0.4",
    "info": {
        "title": "World City API",
        "description": "This is a simple Express API based on the World Cities Database. It supports basic city and province listings, along with filtering based on Country Code",
        "version": "1.0.0",
        "termsOfService": "http://swagger.io/terms",
        "contact": {
            "email": "cab230@qut.edu.au"
        },
        "license": {
            "name": "Apache 2.0",
            "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
        }
    },
    "servers": [
        {
            "url": "/"
        }
    ],
    "tags": [
        {
            "name": "query",
            "description": "API queries based on city and optional country code."
        }
    ],
    "paths": {
        "/api/city": {
            "get": {
                "tags": [
                    "query"
                ],
                "summary": "List cities and districts",
                "description": "Full listing of cities and their districts for the database",
                "operationId": "listCitiesAndDistricts",
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "enum": [
                                                "true",
                                                "false"
                                            ]
                                        },
                                        "message": {
                                            "type": "string",
                                            "enum": [
                                                "Success",
                                                "Error in MySQL query"
                                            ]
                                        },
                                        "cities": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "name": {
                                                        "type": "string"
                                                    },
                                                    "district": {
                                                        "type": "string"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/city/:countryCode": {
            "get": {
                "tags": [
                    "query"
                ],
                "summary": "List cites and districts for country",
                "description": "Full listing of cities and their districts for a country for the database",
                "operationId": "listCitiesAndDistrictsForCountry",
                "parameters": [
                    {
                        
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "enum": [
                                                "true",
                                                "false"
                                            ]
                                        },
                                        "message": {
                                            "type": "string",
                                            "enum": [
                                                "Success",
                                                "Error in MySQL query"
                                            ]
                                        },
                                        "cities": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "name": {
                                                        "type": "string"
                                                    },
                                                    "district": {
                                                        "type": "string"
                                                    },
                                                    "countryCode": {
                                                        "type": "string"
                                                    },
                                                    "population": {
                                                        "type": "string"
                                                    },
                                                    "id": {
                                                        "type": "integer"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}